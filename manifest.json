{
  "name": "dsh-session-sound",
  "displayName": "会话提示音 · Session Sound Alert",
  "version": "1.0.1",
  "description": "DeepSeek Harness Web 会话暂停与结束时播放提示音，可从 Ubuntu Yaru 声音包挑选音效，两种提示音独立配置。",
  "type": "dynamic-cordis-plugin",
  "platform": "client+host",
  "idPrefix": "snd",
  "entry": {
    "host": "plugin.host.js",
    "client": "plugin.client.js"
  },
  "assetsDir": "assets",
  "license": "MIT (code) / CC-BY-SA-4.0 (sound assets)",
  "sounds": [
    "audio-volume-change",
    "battery-low",
    "bell",
    "complete",
    "desktop-login",
    "desktop-logoff",
    "device-added",
    "device-removed",
    "dialog-error",
    "dialog-question",
    "dialog-warning",
    "message-new-email",
    "message-new-instant",
    "trash-empty",
    "warty-startup"
  ]
}
